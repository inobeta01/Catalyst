# Phoenix / Arize
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_OTLP_ENDPOINT=
PHOENIX_PROJECT_NAME=catalyst
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_BASE_URL=http://127.0.0.1:6006

# OTEL
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=space_id=,api_key=    # fill: space_id=<your_space_id>,api_key=<your_api_key>
OTEL_SERVICE_NAME=catalyst

# AgentOps
AGENTOPS_API_KEY=

# OpenAI / LLM
FREE_LLM_API=

# Sandbox
SANDBOX_TYPE=e2b
SANDBOX_API_KEY=
SANDBOX_BASE_URL=https://e2b.dev

# Database
DB_USER=catalyst
DB_PASSWORD=changeme
DB_HOST=neon-db-host
DB_PORT=5432
DB_NAME=catalyst_db
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require"

# Runtime Config
CATALYST_ENV=development                  # development | production
CATALYST_LOG_LEVEL=INFO
CATALYST_EVAL_TIMEOUT_SECONDS=30          # how long to wait for plugin verdict before infra-error
CATALYST_EVAL_POLL_INTERVAL_SECONDS=2     # poll interval when waiting for verdict
NEON_BRANCH=production